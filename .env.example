# Copy this file to `.env` and fill it in, then: docker compose up -d
#
#   cp .env.example .env        # POSIX
#   copy .env.example .env      # Windows
#
# `.env` is gitignored. This file is not, so never put a real value in here.
# -> docker/README.md


# ── Signing in to Claude ───────────────────────────────────────────────────
#
# Set ONE of the two below. A subscription is the usual choice.
#
# ⚠ `claude setup-token` PRINTS the token and stores nothing. Its own last two
# lines say so — "You won't be able to see it again" and "Use this token by
# setting: export CLAUDE_CODE_OAUTH_TOKEN=<token>". Both are instructions for
# you, not a description of something it already did. Copy the token out of the
# terminal and paste it below.
#
# Run it wherever you already have Claude Code — your own machine is fine, it
# does not have to be the server, and it does not have to be inside a container:
#
#   claude setup-token
#
CLAUDE_CODE_OAUTH_TOKEN=

# Only if you pay per token instead. Leave blank when using the line above.
ANTHROPIC_API_KEY=


# ── Where the company lives ────────────────────────────────────────────────
#
# A real folder on your disk, so you can open it, edit it, back it up by copying
# it, and carry it to another machine the same way. Relative paths are resolved
# against this file.
#
# ⚠ IT IS UNDER `docker/` SO IT CAN NEVER BE THE DESKTOP ONE. `agentco init`
# creates `./company`; this door creates `./docker/company`. Two daemons writing
# a single company folder is not a supported arrangement — they would overwrite
# each other's `.state/daemon.json`, so `agentco status` and the launcher would
# point at whichever process wrote last rather than the one actually serving.
# Different names means the question never comes up.
#
# ⚠ IF YOU CHANGE IT, MAKE SURE GIT IGNORES THE NEW PATH. A company holds
# `.state/secrets.json` — live OAuth tokens for every account you have
# connected. `/company/` and `/docker/company/` are both covered already.
#
COMPANY_PATH=./docker/company


# ── The port ───────────────────────────────────────────────────────────────
#
# One variable, read in four places that must agree: the host side of the
# mapping, the container side, the port the daemon listens on, and the address
# handed to OAuth providers. Same number everywhere, so `docker ps` reads
# `7317->7317` with nothing to translate.
#
# Change it when 7317 is already taken — most often by a desktop install of
# agentco on the same machine. The symptom is `Ports are not available` at `up`,
# before any agentco log line, and agentco's own port self-healing cannot rescue
# it: Docker fails to publish the port, so the daemon that knows how to move is
# never started.
#
AGENTCO_PORT=7317
